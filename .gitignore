# Secrets - NEVER commit
.env
.env.*
!.env.example
infra.env
*.env
!*.env.example

# Connector configs embed kafka.api.secret - generated by scripts/recreate-all.sh.
# Because every file in connectors/ is ignored and git cannot track an empty
# directory, connectors/ does not exist on a fresh clone - recreate-all.sh does
# `mkdir -p connectors` before writing into it.
connectors/*.json
*-credentials.json
*-secrets.json
service-account*.json
api-key*.txt
*.pem
*.key

# Confluent CLI local state
.confluent/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Runtime
logs/
*.log
tmp/
node_modules/
venv/
.venv/
__pycache__/
*.pyc
